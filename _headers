# Cloudflare Pages — header keamanan
#
# Catatan: semua aset harus dari origin yang sama. Logo disarankan berupa file
# di dalam repo yang sama (mis. /logo-smancip.png, /logo-mpk.png), atau pakai
# data: URI langsung di index.html.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
